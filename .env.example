# Backend URL used by production builds. Leave unset to use the default
# Render deployment (https://avenyar-global-server.onrender.com).
# VITE_API_URL=https://api.example.com

# Dev only: where the Vite /api proxy forwards to (e.g. a local backend).
# API_PROXY_TARGET=http://localhost:8000

# Where the homepage enquiry form POSTs (JSON). Use a backend route or a form
# service URL such as https://formspree.io/f/<id>. Unset = email-draft fallback.
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxx
